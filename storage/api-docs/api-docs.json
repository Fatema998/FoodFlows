{
    "openapi": "3.0.0",
    "info": {
        "title": "My API",
        "version": "1.0"
    },
    "paths": {
        "/api/auth/register": {
            "post": {
                "tags": [
                    "Auth"
                ],
                "summary": "User Registration",
                "description": "Register a new user. Role is automatically set to 'user'.",
                "operationId": "c7bb21a0d87049e161b8e4c9b0d909f2",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "name",
                                    "email",
                                    "password",
                                    "password_confirmation"
                                ],
                                "properties": {
                                    "name": {
                                        "type": "string",
                                        "example": "John Doe"
                                    },
                                    "email": {
                                        "type": "string",
                                        "format": "email",
                                        "example": "john@example.com"
                                    },
                                    "password": {
                                        "type": "string",
                                        "format": "password",
                                        "example": "123456"
                                    },
                                    "password_confirmation": {
                                        "type": "string",
                                        "format": "password",
                                        "example": "123456"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "User registered successfully",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "success": {
                                            "type": "boolean",
                                            "example": true
                                        },
                                        "status": {
                                            "type": "string",
                                            "example": "success"
                                        },
                                        "message": {
                                            "type": "string",
                                            "example": "User registered successfully"
                                        },
                                        "data": {
                                            "properties": {
                                                "id": {
                                                    "type": "integer",
                                                    "example": 1
                                                },
                                                "name": {
                                                    "type": "string",
                                                    "example": "John Doe"
                                                },
                                                "email": {
                                                    "type": "string",
                                                    "example": "john@example.com"
                                                },
                                                "role": {
                                                    "type": "string",
                                                    "example": "user"
                                                }
                                            },
                                            "type": "object"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Validation error",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "success": {
                                            "type": "boolean",
                                            "example": false
                                        },
                                        "status": {
                                            "type": "string",
                                            "example": "error"
                                        },
                                        "message": {
                                            "type": "string",
                                            "example": "Validation failed"
                                        },
                                        "errors": {
                                            "properties": {
                                                "email": {
                                                    "type": "string",
                                                    "example": "The email has already been taken."
                                                }
                                            },
                                            "type": "object"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/auth/login": {
            "post": {
                "tags": [
                    "Auth"
                ],
                "summary": "User login",
                "description": "Authenticate user with email and password",
                "operationId": "dd51a484b7fa0f97c7680fdbde14cf5f",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "email",
                                    "password"
                                ],
                                "properties": {
                                    "email": {
                                        "type": "string",
                                        "format": "email",
                                        "example": "john@example.com"
                                    },
                                    "password": {
                                        "type": "string",
                                        "format": "password",
                                        "example": "123456"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Successful login",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "success": {
                                            "type": "boolean",
                                            "example": true
                                        },
                                        "status": {
                                            "type": "string",
                                            "example": "success"
                                        },
                                        "message": {
                                            "type": "string",
                                            "example": "Login successful"
                                        },
                                        "data": {
                                            "properties": {
                                                "token": {
                                                    "type": "string",
                                                    "example": "eyJ0eXAiOiJKV1QiLCJhbGciOi..."
                                                },
                                                "user": {
                                                    "properties": {
                                                        "id": {
                                                            "type": "integer",
                                                            "example": 1
                                                        },
                                                        "name": {
                                                            "type": "string",
                                                            "example": "John Doe"
                                                        },
                                                        "email": {
                                                            "type": "string",
                                                            "example": "john@example.com"
                                                        }
                                                    },
                                                    "type": "object"
                                                }
                                            },
                                            "type": "object"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Invalid credentials"
                    }
                }
            }
        },
        "/api/auth/profile": {
            "get": {
                "tags": [
                    "Auth"
                ],
                "summary": "Get User Profile",
                "description": "Retrieve authenticated user profile",
                "operationId": "18b2d1b72b1e2987c1eece1cf7318b47",
                "responses": {
                    "200": {
                        "description": "Profile retrieved successfully",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "success": {
                                            "type": "boolean",
                                            "example": true
                                        },
                                        "status": {
                                            "type": "string",
                                            "example": "success"
                                        },
                                        "message": {
                                            "type": "string",
                                            "example": "Profile retrieved successfully"
                                        },
                                        "data": {
                                            "properties": {
                                                "id": {
                                                    "type": "integer",
                                                    "example": 1
                                                },
                                                "name": {
                                                    "type": "string",
                                                    "example": "John Doe"
                                                },
                                                "email": {
                                                    "type": "string",
                                                    "example": "john@example.com"
                                                }
                                            },
                                            "type": "object"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Unauthorized"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        },
        "/api/auth/logout": {
            "get": {
                "tags": [
                    "Auth"
                ],
                "summary": "User Logout",
                "description": "Logout and revoke access token",
                "operationId": "65f941718b9ea1af703cde99d03d1e82",
                "responses": {
                    "200": {
                        "description": "User logged out successfully",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "success": {
                                            "type": "boolean",
                                            "example": true
                                        },
                                        "status": {
                                            "type": "string",
                                            "example": "success"
                                        },
                                        "message": {
                                            "type": "string",
                                            "example": "User logged out successfully"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Unauthorized"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        },
        "/api/products": {
            "get": {
                "tags": [
                    "Products"
                ],
                "summary": "Get all products",
                "operationId": "d97d1c3727cbac49708b85f7d11f7d58",
                "responses": {
                    "200": {
                        "description": "List of products",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "status": {
                                            "type": "string",
                                            "example": "success"
                                        },
                                        "message": {
                                            "type": "string",
                                            "example": "Success"
                                        },
                                        "data": {
                                            "type": "array",
                                            "items": {
                                                "$ref": "#/components/schemas/ProductListResource"
                                            }
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/products/{slug}": {
            "get": {
                "tags": [
                    "Products"
                ],
                "summary": "Get a product by slug",
                "operationId": "5bbb6d725346d38781b256ed5c715d62",
                "parameters": [
                    {
                        "name": "slug",
                        "in": "path",
                        "description": "The slug of the product",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "example": "samsung-galaxy-s23"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Product details",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "status": {
                                            "type": "string",
                                            "example": "success"
                                        },
                                        "message": {
                                            "type": "string",
                                            "example": "Success"
                                        },
                                        "data": {
                                            "$ref": "#/components/schemas/SingleProductResource"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "Product not found",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "status": {
                                            "type": "string",
                                            "example": "error"
                                        },
                                        "message": {
                                            "type": "string",
                                            "example": "Product not found"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    }
                }
            }
        }
    },
    "components": {
        "schemas": {
            "ProductListResource": {
                "title": "Product List Resource",
                "description": "Product resource response",
                "properties": {
                    "id": {
                        "type": "integer",
                        "example": 1
                    },
                    "title": {
                        "type": "string",
                        "example": "T-shirt"
                    },
                    "slug": {
                        "type": "string",
                        "example": "t-shirt"
                    },
                    "price": {
                        "type": "number",
                        "format": "float",
                        "example": 1200.5
                    },
                    "discount": {
                        "type": "number",
                        "format": "float",
                        "example": 100
                    },
                    "sold_price": {
                        "type": "number",
                        "format": "float",
                        "example": 1100.5
                    },
                    "quantity": {
                        "type": "integer",
                        "example": 20
                    },
                    "is_trending": {
                        "type": "boolean",
                        "example": true
                    },
                    "is_limited": {
                        "type": "boolean",
                        "example": false
                    },
                    "is_active": {
                        "type": "boolean",
                        "example": true
                    },
                    "is_featured": {
                        "type": "boolean",
                        "example": false
                    },
                    "is_flash_deal": {
                        "type": "boolean",
                        "example": true
                    },
                    "flash_deal_start": {
                        "type": "string",
                        "format": "date-time"
                    },
                    "flash_deal_end": {
                        "type": "string",
                        "format": "date-time"
                    },
                    "sizes": {
                        "type": "array",
                        "items": {
                            "properties": {
                                "id": {
                                    "type": "integer",
                                    "example": 1
                                },
                                "name": {
                                    "type": "string",
                                    "example": "M"
                                }
                            },
                            "type": "object"
                        }
                    },
                    "variants": {
                        "type": "array",
                        "items": {
                            "properties": {
                                "id": {
                                    "type": "integer",
                                    "example": 1
                                },
                                "color": {
                                    "properties": {
                                        "id": {
                                            "type": "integer",
                                            "example": 1
                                        },
                                        "name": {
                                            "type": "string",
                                            "example": "Red"
                                        },
                                        "code": {
                                            "type": "string",
                                            "example": "#FF0000"
                                        }
                                    },
                                    "type": "object"
                                },
                                "image": {
                                    "type": "string",
                                    "example": "http://example.com/image.jpg"
                                }
                            },
                            "type": "object"
                        }
                    },
                    "created_at": {
                        "type": "string",
                        "example": "29/09/2025"
                    },
                    "updated_at": {
                        "type": "string",
                        "example": "29/09/2025"
                    }
                },
                "type": "object"
            },
            "SingleProductResource": {
                "title": "Single Product Resource",
                "properties": {
                    "id": {
                        "type": "integer",
                        "example": 1
                    },
                    "title": {
                        "type": "string",
                        "example": "Premium Cotton T-Shirt"
                    },
                    "slug": {
                        "type": "string",
                        "example": "premium-cotton-t-shirt"
                    },
                    "price": {
                        "type": "number",
                        "format": "float",
                        "example": 1200
                    },
                    "discount": {
                        "type": "number",
                        "format": "float",
                        "example": 200
                    },
                    "sold_price": {
                        "type": "number",
                        "format": "float",
                        "example": 1000
                    },
                    "product_code": {
                        "type": "string",
                        "example": "TSHIRT-2025"
                    },
                    "sell_count": {
                        "type": "integer",
                        "example": 500
                    },
                    "quantity": {
                        "type": "integer",
                        "example": 50
                    },
                    "main_thumbnail": {
                        "type": "string",
                        "example": "https://example.com/images/tshirt.png"
                    },
                    "long_descriptions": {
                        "type": "string",
                        "example": "This is a long description."
                    },
                    "short_description": {
                        "type": "string",
                        "example": "Short description."
                    },
                    "materials": {
                        "type": "string",
                        "example": "100% Cotton"
                    },
                    "is_trending": {
                        "type": "boolean",
                        "example": true
                    },
                    "is_limited": {
                        "type": "boolean",
                        "example": false
                    },
                    "is_active": {
                        "type": "boolean",
                        "example": true
                    },
                    "is_featured": {
                        "type": "boolean",
                        "example": false
                    },
                    "is_flash_deal": {
                        "type": "boolean",
                        "example": false
                    },
                    "flash_deal_start": {
                        "type": "string",
                        "format": "date-time",
                        "example": "2025-01-01 00:00:00"
                    },
                    "flash_deal_end": {
                        "type": "string",
                        "format": "date-time",
                        "example": "2025-01-10 23:59:59"
                    },
                    "brand": {
                        "properties": {
                            "id": {
                                "type": "integer",
                                "example": 1
                            },
                            "name": {
                                "type": "string",
                                "example": "Nike"
                            },
                            "slug": {
                                "type": "string",
                                "example": "nike"
                            }
                        },
                        "type": "object",
                        "nullable": true
                    },
                    "category": {
                        "properties": {
                            "id": {
                                "type": "integer",
                                "example": 2
                            },
                            "name": {
                                "type": "string",
                                "example": "Clothing"
                            },
                            "slug": {
                                "type": "string",
                                "example": "clothing"
                            }
                        },
                        "type": "object",
                        "nullable": true
                    },
                    "subcategory": {
                        "properties": {
                            "id": {
                                "type": "integer",
                                "example": 3
                            },
                            "name": {
                                "type": "string",
                                "example": "T-Shirts"
                            },
                            "slug": {
                                "type": "string",
                                "example": "t-shirts"
                            }
                        },
                        "type": "object",
                        "nullable": true
                    },
                    "sizes": {
                        "type": "array",
                        "items": {
                            "properties": {
                                "id": {
                                    "type": "integer",
                                    "example": 1
                                },
                                "name": {
                                    "type": "string",
                                    "example": "XL"
                                }
                            },
                            "type": "object"
                        }
                    },
                    "variants": {
                        "type": "array",
                        "items": {
                            "properties": {
                                "id": {
                                    "type": "integer",
                                    "example": 10
                                },
                                "color": {
                                    "properties": {
                                        "id": {
                                            "type": "integer",
                                            "example": 5
                                        },
                                        "name": {
                                            "type": "string",
                                            "example": "Red"
                                        },
                                        "code": {
                                            "type": "string",
                                            "example": "#FF0000"
                                        }
                                    },
                                    "type": "object"
                                },
                                "image": {
                                    "type": "string",
                                    "example": "https://example.com/variant-red.png"
                                }
                            },
                            "type": "object"
                        }
                    },
                    "meta_title": {
                        "type": "string",
                        "example": "Buy Premium Cotton T-Shirt"
                    },
                    "meta_description": {
                        "type": "string",
                        "example": "This is the best premium cotton t-shirt."
                    },
                    "meta_keywords": {
                        "type": "string",
                        "example": "tshirt, cotton, fashion"
                    },
                    "created_at": {
                        "type": "string",
                        "example": "29/09/2025"
                    },
                    "updated_at": {
                        "type": "string",
                        "example": "29/09/2025"
                    }
                },
                "type": "object"
            }
        },
        "securitySchemes": {
            "bearerAuth": {
                "type": "http",
                "bearerFormat": "JWT",
                "scheme": "bearer"
            }
        }
    },
    "tags": [
        {
            "name": "Auth",
            "description": "Auth"
        },
        {
            "name": "Products",
            "description": "Products"
        }
    ]
}